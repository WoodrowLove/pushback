# Anthropic API key — required.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-4-5-20250929.
# Bills are dense; Sonnet handles them well. Use Opus only for the appeal-letter
# step if you want max polish.
PUSHBACK_MODEL=claude-sonnet-4-5-20250929

# Optional. Set to "1" to log full prompts/responses to stderr for debugging.
# NEVER turn on in production — it logs PHI.
PUSHBACK_DEBUG=

# Public app URL. Used for absolute URLs in copy + sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
